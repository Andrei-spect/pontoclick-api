# Copie este arquivo para ".env" e preencha com os seus dados reais.
# NUNCA suba o arquivo ".env" pro Git/GitHub (ele já está no .gitignore).

# --- Banco de dados MySQL (via XAMPP) ---
# Por padrão, o MySQL do XAMPP roda com usuário "root" e SENHA EM BRANCO.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pontoclick
# Banco na nuvem (TiDB Cloud etc.): conexão criptografada obrigatória.
# DB_SSL=true

# --- Servidor ---
PORT=3000
# Em produção, defina NODE_ENV=production (a API passa a exigir o SMTP configurado).
# NODE_ENV=production
# Atrás de proxy/hospedagem (Render, Railway, Nginx): TRUST_PROXY=1
# Para limitar o app web a um domínio: CORS_ORIGINS=https://app.seu-dominio.com.br

# --- Autenticação (JWT) ---
# Gere uma string aleatória longa (trocá-la desconecta todos os usuários):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# --- E-mail (recuperação de senha e suporte) ---
# Opção 1 — Brevo (API HTTPS). Use em hospedagens que bloqueiam SMTP (plano gratuito do Render).
# Chave em app.brevo.com > SMTP & API > API Keys. O remetente precisa estar verificado no Brevo.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=seu-email@gmail.com
# MAIL_FROM_NAME=PontoClick
#
# Opção 2 — SMTP (usado quando não há BREVO_API_KEY).
# Use sempre uma SENHA DE APP, nunca a senha da conta.
# Gmail: smtp.gmail.com, porta 587, senha de app em myaccount.google.com/apppasswords
# iCloud: smtp.mail.me.com, porta 587, senha de app em account.apple.com
# Sem SMTP_PASS, em desenvolvimento os e-mails aparecem só no terminal da API.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=
SMTP_FROM='"PontoClick" <seu-email@gmail.com>'

# --- Fotos de perfil ---
# "disk" (padrão) grava em uploads/; "db" grava no banco (hospedagem sem disco permanente, como o Render gratuito).
# PHOTO_STORAGE=disk

# --- Suporte ---
# Para onde vão as mensagens da tela "Ajuda e suporte" (padrão: MAIL_FROM_EMAIL ou SMTP_USER).
SUPPORT_EMAIL=suporte@seu-dominio.com.br
